DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_USERNAME=<neon-username>
DB_PASSWORD=<neon-password>

JWT_SECRET=<change-this-to-a-long-random-secret>
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

BOOTSTRAP_ADMIN_EMAIL=admin@lowlands.coffee
BOOTSTRAP_ADMIN_PASSWORD=<change-this-password>
BOOTSTRAP_ADMIN_FULL_NAME=Lowlands Admin

NEXT_PUBLIC_API_URL=https://<api-domain>/api/v1
NEXT_PUBLIC_APP_URL=https://<frontend-domain>
NEXT_PUBLIC_MINIO_URL=https://<minio-public-domain>
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://<frontend-domain>

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=lowlands
MINIO_PUBLIC_BASE_URL=https://<minio-public-domain>/lowlands
STORAGE_MAX_FILE_SIZE=5242880

VNPAY_TMN_CODE=<vnpay-tmn-code>
VNPAY_HASH_SECRET=<vnpay-hash-secret>
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://<api-domain>/api/v1/payment/vnpay/return
FRONTEND_PAYMENT_RESULT_URL=https://<frontend-domain>/vi/payment/result

BACKEND_PORT=8080
FRONTEND_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
